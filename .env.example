# Copy to .env and adjust. All values are optional; defaults are shown.

POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce

# Must be at least 256 bits (32+ characters)
APP_JWT_SECRET=sample-ecommerce-demo-jwt-secret-key-must-be-long-enough-256bits
APP_DEMO_RESET_ENABLED=true

BACKEND_PORT=8080
FRONTEND_PORT=5173
